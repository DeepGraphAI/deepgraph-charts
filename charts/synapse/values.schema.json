{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synapse Helm chart values",
  "description": "Structural validation. Cross-field rules that JSON Schema cannot express (a password being required, cluster mode needing persistence) are enforced by the templates and produce a named error at render time.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$",
          "description": "Empty, or a sha256 digest"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "commonLabels": {
      "type": "object"
    },
    "commonAnnotations": {
      "type": "object"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "dataDir": {
      "type": "string",
      "pattern": "^/"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "secretKeys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "enforcePassword": {
          "type": "boolean",
          "description": "Re-apply auth.password to an existing data directory at every start. A first install always applies it regardless. Turn off only to manage the admin password through GQL."
        }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "enterprise",
            "professional",
            "graphlite"
          ]
        },
        "licenseKey": {
          "type": "string"
        },
        "existingLicenseSecret": {
          "type": "string"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grpc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "agentTimeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "maxConnections": {
              "type": "integer",
              "minimum": 1
            },
            "debugEndpoints": {
              "type": "boolean"
            },
            "corsOrigins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "bolt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "languages": {
              "type": "string",
              "minLength": 1
            },
            "maxConnections": {
              "type": "integer",
              "minimum": 1
            },
            "idleTimeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "advertisedAddress": {
              "type": "string"
            }
          }
        },
        "logLevel": {
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "logFormat": {
          "enum": [
            "json",
            "text"
          ]
        },
        "maxInboundMb": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutboundMb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2047
        },
        "maxConcurrentStreams": {
          "type": "integer",
          "minimum": 1
        },
        "stagingDir": {
          "type": "string",
          "pattern": "^/"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ml": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Build and use the Python/AI runtime. false starts the server directly and skips the ~4GB environment build."
        },
        "models": {
          "type": "string",
          "minLength": 1,
          "description": "none, all, or a comma-separated subset"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mlEnv": {
              "$ref": "#/$defs/volume"
            },
            "models": {
              "$ref": "#/$defs/volume"
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "synapseToml": {
          "type": "string"
        },
        "existingConfigMap": {
          "type": "string"
        }
      }
    },
    "externalAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "config": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "raftPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "rpcTimeoutMs": {
          "type": "integer",
          "minimum": 100
        },
        "snapshotLogsThreshold": {
          "$ref": "#/$defs/optionalInt"
        },
        "maxInSnapshotLogToKeep": {
          "$ref": "#/$defs/optionalInt"
        },
        "raft": {
          "type": "object",
          "additionalProperties": false,
          "description": "Keep heartbeat < electionMin < electionMax; the server validates this and refuses to start on an invalid combination.",
          "properties": {
            "heartbeatIntervalMs": {
              "$ref": "#/$defs/optionalInt"
            },
            "electionTimeoutMinMs": {
              "$ref": "#/$defs/optionalInt"
            },
            "electionTimeoutMaxMs": {
              "$ref": "#/$defs/optionalInt"
            },
            "maxPayloadEntries": {
              "$ref": "#/$defs/optionalInt"
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "annotations": {
          "type": "object"
        },
        "loadBalancerIP": {
          "type": "string"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalTrafficPolicy": {
          "enum": [
            "",
            "Cluster",
            "Local"
          ]
        },
        "sessionAffinity": {
          "enum": [
            "None",
            "ClientIP"
          ]
        },
        "nodePorts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grpc": {
              "$ref": "#/$defs/optionalInt"
            },
            "http": {
              "$ref": "#/$defs/optionalInt"
            },
            "bolt": {
              "$ref": "#/$defs/optionalInt"
            }
          }
        }
      }
    },
    "headlessService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object"
        },
        "publishNotReadyAddresses": {
          "type": "boolean"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "enum": [
                        "Exact",
                        "Prefix",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "$ref": "#/$defs/quantity"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "items": {
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteMany",
                  "ReadOnlyMany",
                  "ReadWriteOncePod"
                ]
              }
            },
            "annotations": {
              "type": "object"
            },
            "retentionPolicy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "whenDeleted": {
                  "enum": [
                    "Retain",
                    "Delete"
                  ]
                },
                "whenScaled": {
                  "enum": [
                    "Retain",
                    "Delete"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "$ref": "#/$defs/probe"
        },
        "liveness": {
          "$ref": "#/$defs/probe"
        },
        "readiness": {
          "$ref": "#/$defs/probe"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podAntiAffinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "soft",
            "hard"
          ]
        },
        "topologyKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "updateStrategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "RollingUpdate",
            "OnDelete"
          ]
        },
        "rollingUpdate": {
          "type": "object"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "string",
            "integer"
          ]
        },
        "maxUnavailable": {
          "type": [
            "string",
            "integer"
          ]
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedClients": {
          "type": "array"
        },
        "allowExternalEgress": {
          "type": "boolean"
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podAnnotations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            },
            "interval": {
              "$ref": "#/$defs/duration"
            },
            "scrapeTimeout": {
              "$ref": "#/$defs/duration"
            },
            "honorLabels": {
              "type": "boolean"
            },
            "relabelings": {
              "type": "array"
            },
            "metricRelabelings": {
              "type": "array"
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            },
            "rules": {
              "type": "object"
            },
            "extraRules": {
              "type": "array"
            }
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "labelValue": {
              "type": "string"
            },
            "folder": {
              "type": "string"
            },
            "extraLabels": {
              "type": "object"
            }
          }
        },
        "otel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string"
            },
            "protocol": {
              "enum": [
                "grpc",
                "http"
              ]
            },
            "serviceName": {
              "type": "string"
            },
            "sampleRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "exportTimeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "environment": {
              "type": "string"
            }
          }
        }
      }
    },
    "serviceMesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "istio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "injectSidecar": {
              "type": "boolean"
            },
            "peerAuthentication": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "mode": {
                  "enum": [
                    "STRICT",
                    "PERMISSIVE",
                    "DISABLE"
                  ]
                }
              }
            },
            "gateway": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "selector": {
                  "type": "object"
                },
                "hosts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exposeGrpc": {
                  "type": "boolean"
                },
                "tls": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "mode": {
                      "enum": [
                        "SIMPLE",
                        "MUTUAL"
                      ]
                    },
                    "credentialName": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "virtualService": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "hosts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "extraGateways": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "timeout": {
                  "$ref": "#/$defs/duration"
                },
                "retries": {
                  "type": "object"
                }
              }
            },
            "destinationRule": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "connectionPool": {
                  "type": "object"
                },
                "outlierDetection": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "extraInitContainers": {
      "type": "array"
    },
    "extraContainers": {
      "type": "array"
    },
    "extraManifests": {
      "type": "array"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    }
  },
  "$defs": {
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h)$"
    },
    "optionalInt": {
      "type": [
        "integer",
        "string"
      ],
      "description": "An integer, or an empty string meaning 'use the server default'",
      "pattern": "^$|^[0-9]+$"
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "$ref": "#/$defs/quantity"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteMany",
              "ReadOnlyMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    }
  }
}
